DEBUG=True
PROD_RUN=false
RESET_DB_ON_STARTUP=false
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=password

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=auth

REDIS_HOST=redis
REDIS_PORT=6379

PRIVATE_KEY_PATH=/run/secrets/jwt/jwt-private.pem
PUBLIC_KEY_PATH=/run/secrets/jwt/jwt-public.pem

TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_PREFIX=rate_limit
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_IP_LIMIT=100
RATE_LIMIT_IP_WINDOW_SECONDS=60

TRACING_ENABLED=false
REQUEST_ID_HEADER=x-request-id

YANDEXID_AUTH_URL=http://yandex-mock:8080/authorize
YANDEXID_TOKEN_URL=http://yandex-mock:8080/token
YANDEXID_USER_INFO_URL=http://yandex-mock:8080/info
YANDEXID_REDIRECT_URL=https://oauth.yandex.ru/verification_code
YANDEXID_CLIENT_ID=your-client-id
YANDEXID_CLIENT_SECRET=your-client-secret
YANDEX_CONFIRMATION_CODE_TTL=600
YANDEXID_HTTP_TIMEOUT_SECONDS=1
